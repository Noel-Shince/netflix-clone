rules_version = '2';

// Firestore security rules (slice 11). Deploy with:
//   npx firebase-tools deploy --only firestore:rules
// or paste this file into Firebase console > Firestore Database > Rules.
//
// Anything not matched below is denied. Firestore ORs every `allow` that
// matches a path, so there is deliberately no permissive catch-all: it would
// override the validation in the specific blocks.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Viewing profiles: users/{uid}/profiles/{slot}. Fixed slot ids cap an
    // account at five profiles (see src/lib/profiles.ts).
    match /users/{uid}/profiles/{profileId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && profileId in ['p1', 'p2', 'p3', 'p4', 'p5']
        && validProfile(request.resource.data);

      function validProfile(data) {
        return data.keys().hasOnly(['name', 'avatar', 'createdAt'])
          && data.keys().hasAll(['name', 'avatar', 'createdAt'])
          && data.name is string
          && data.name.size() >= 1
          && data.name.size() <= 20
          && data.avatar in ['red', 'blue', 'yellow', 'green', 'purple', 'teal', 'orange', 'pink']
          && data.createdAt is int;
      }
    }

    // Account-level settings (slice 22): currently just the viewer's own
    // stream resolver API key/token (src/lib/streamSettings.ts). Unlike
    // profile data below, this is one doc per account, not per profile.
    match /users/{uid}/settings/preferences {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['streamApiKey'])
        && (request.resource.data.streamApiKey == null
          || (request.resource.data.streamApiKey is string
            && request.resource.data.streamApiKey.size() <= 500));
    }

    // My List (slice 12): one doc per saved title under the viewing profile,
    // owner-only, with the fields checked on every write.
    match /users/{uid}/profiles/{profileId}/myList/{titleKey} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['id', 'mediaType', 'name', 'imageUrl', 'addedAt'])
        && request.resource.data.id is int
        && request.resource.data.mediaType in ['movie', 'tv']
        && titleKey == request.resource.data.mediaType + '-' + string(request.resource.data.id)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 300
        && (request.resource.data.imageUrl == null
          || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 500))
        && request.resource.data.addedAt == request.time;
    }

    // Playback resume points (slice 18, season/episode added for the VidKing
    // episode selector): one doc per title under the viewing profile,
    // written from the player's postMessage events.
    match /users/{uid}/profiles/{profileId}/watchProgress/{titleKey} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
          ['id', 'mediaType', 'name', 'progressSeconds', 'durationSeconds', 'completed', 'season', 'episode', 'updatedAt']
        )
        && request.resource.data.id is int
        && request.resource.data.mediaType in ['movie', 'tv']
        && titleKey == request.resource.data.mediaType + '-' + string(request.resource.data.id)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 300
        && request.resource.data.progressSeconds is int
        && request.resource.data.progressSeconds >= 0
        && (request.resource.data.durationSeconds == null || request.resource.data.durationSeconds is int)
        && request.resource.data.completed is bool
        && (request.resource.data.season == null || request.resource.data.season is int)
        && (request.resource.data.episode == null || request.resource.data.episode is int)
        && request.resource.data.updatedAt == request.time;
    }

    // TMDB-id -> IMDB-id cache (slice 22, src/services/externalIds.ts), for
    // the stream resolver. Shared across every viewer rather than per-user —
    // it only ever caches TMDB's own public data, so there is nothing to
    // isolate per account — but still signed-in-only, since this is a write
    // path and the app has no backend to run it through.
    match /externalIdsCache/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['tmdbId', 'mediaType', 'imdbId', 'cachedAt'])
        && request.resource.data.tmdbId is int
        && request.resource.data.mediaType in ['movie', 'tv']
        && docId == request.resource.data.mediaType + '-' + string(request.resource.data.tmdbId)
        && (request.resource.data.imdbId == null || request.resource.data.imdbId is string)
        && request.resource.data.cachedAt == request.time;
    }
  }
}
