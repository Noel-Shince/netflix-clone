# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Never commit real keys.
#
# Everything prefixed VITE_ is bundled into client code and visible in the
# browser. These are identifiers/limited keys, not true secrets.

# --- TMDB (https://www.themoviedb.org/settings/api) ---
# Use the "API Read Access Token" (v4 bearer token), not the short v3 key.
VITE_TMDB_READ_TOKEN=

# --- Firebase (Project settings > General > Your apps > Web app config) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
